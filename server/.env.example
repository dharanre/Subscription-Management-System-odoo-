# Copy to server/.env to override defaults. Nothing here is a secret; the app has no third-party keys.

# API port. The Vite dev server proxies /api to this.
PORT=4000

# SQLite file. Defaults to server/data/brightloop.db (created on first start).
# DB_PATH=

# Public URL of the web app, used to build password-reset links. Vite dev default shown.
APP_URL=http://localhost:5173

# Password hashing cost (bcrypt). 10 is a sensible default; raise it on faster hardware.
BCRYPT_COST=10

SESSION_TTL_HOURS=168
RESET_TTL_MINUTES=30

# Local "mail server": reset emails are saved to server/data/outbox and shown in the app at
# /dev/mailbox. Defaults to on outside production. Never enable on a public deployment.
DEV_MAILBOX=true
